# ==============================================================================
# Voice Assistant - Environment Configuration (.env.example)
# Copy this file to .env and adjust as necessary for your local Windows environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (MongoDB)
# Local Docker or MongoDB Atlas connection string
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voice_assistant
# Optional Mongo Express port if using docker-compose
MONGO_EXPRESS_PORT=8081

# ------------------------------------------------------------------------------
# Backend API (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Ollama LLM Settings
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Voice Pipeline: Speech-to-Text (faster-whisper)
# Model options: tiny.en, base.en, small.en, medium.en
# Device options: cpu, cuda (or auto)
# ------------------------------------------------------------------------------
STT_MODEL_SIZE=small.en
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# Voice Pipeline: Text-to-Speech (Piper)
# Configurable local Piper voice model
# ------------------------------------------------------------------------------
PIPER_VOICE_NAME=en_US-lessac-medium
PIPER_MODEL_PATH=./voice/models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=./voice/models/en_US-lessac-medium.onnx.json

# ------------------------------------------------------------------------------
# Voice Pipeline: VAD & Latency Logging
# ------------------------------------------------------------------------------
VAD_CONFIDENCE_THRESHOLD=0.5
LOG_LATENCY_METRICS=true

# ------------------------------------------------------------------------------
# Default Business Context (Used by Voice Pipeline if not passed explicitly)
# ------------------------------------------------------------------------------
DEFAULT_BUSINESS_ID=cafe_demo_001

# ------------------------------------------------------------------------------
# Dashboard (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PORT=3000
